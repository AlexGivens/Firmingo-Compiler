          "const": "application"
        },
        "qualification": {
          "const": "experimental"
        },
        "firmwareVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "firmwareCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "residentELFSHA256": {
          "type": "string",
          "minLength": 1,
