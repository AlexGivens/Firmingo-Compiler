{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Firmingo Compiler cancellation input \u2014 interface one draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interfaceVersion",
    "kind",
    "buildID"
  ],
  "properties": {
    "interfaceVersion": {
      "const": 1
    },
    "kind": {
      "const": "cancel"
    },
    "buildID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
