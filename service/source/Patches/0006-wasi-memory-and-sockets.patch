+//===- WASI/Memory.inc - WASI memory support -----------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include <cstdlib>
+
+namespace llvm {
+namespace sys {
+
+MemoryBlock Memory::allocateMappedMemory(size_t NumBytes,
+                                         const MemoryBlock *const NearBlock,
+                                         unsigned Flags,
+                                         std::error_code &EC) {
+  (void)NearBlock;
+  EC = std::error_code();
+  if (NumBytes == 0)
+    return MemoryBlock();
+
+  if (Flags & MF_EXEC) {
+    EC = std::make_error_code(std::errc::operation_not_supported);
+    return MemoryBlock();
+  }
+
+  // Native mapped memory is zero-filled. LLD relies on that contract for
+  // deterministic padding between output sections.
+  void *Address = std::calloc(NumBytes, 1);
+  if (!Address) {
+    EC = std::make_error_code(std::errc::not_enough_memory);
+    return MemoryBlock();
+  }
+
+  MemoryBlock Result;
+  Result.Address = Address;
+  Result.AllocatedSize = NumBytes;
+  Result.Flags = Flags;
+  return Result;
+}
+
+std::error_code Memory::releaseMappedMemory(MemoryBlock &Block) {
+  std::free(Block.Address);
+  Block.Address = nullptr;
+  Block.AllocatedSize = 0;
+  return std::error_code();
+}
+
+std::error_code Memory::protectMappedMemory(const MemoryBlock &Block,
+                                            unsigned Flags) {
+  (void)Block;
+  if (!Flags)
+    return std::make_error_code(std::errc::invalid_argument);
+  if (Flags & MF_EXEC)
+    return std::make_error_code(std::errc::operation_not_supported);
+  return std::error_code();
+}
+
+void Memory::InvalidateInstructionCache(const void *Address, size_t Length) {
+  (void)Address;
+  (void)Length;
+}
+
+} // namespace sys
+} // namespace llvm
