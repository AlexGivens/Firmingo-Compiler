{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared supplied-ELF packaging receipt; no executed assets or compilation proof",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptSchema",
        "operation",
        "provenanceStatus",
        "requestSHA256",
        "buildID",
        "sourceRevision",
        "sourceFilename",
        "sourceSHA256",
        "translationUnitSHA256",
        "firmwareBuildID",
        "board",
        "profile",
        "provenance",
        "buildInputSHA256",
        "linkedELFSHA256",
        "capsuleSHA256",
        "capsuleBytes"
      ],
      "properties": {
        "receiptSchema": {
          "const": "firmingo-compiler-declared-packaging-v1"
        },
        "operation": {
          "const": "independent_elf_packaging"
        },
        "provenanceStatus": {
          "const": "declared"
        },
        "requestSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "buildID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceFilename": {
          "type": "string"
        },
        "sourceSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "translationUnitSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "firmwareBuildID": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "board": {
          "const": "nano_rp2040_connect"
        },
        "profile": {
          "enum": [
            "nano-managed-v1",
            "nano-managed-v2"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compiler",
            "recipeIdentifier",
            "recipeSHA256",
            "toolchainSHA256"
          ],
          "properties": {
            "compiler": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-maximumUtf8Bytes": 256
            },
            "recipeIdentifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "recipeSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "toolchainSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "buildInputSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "linkedELFSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capsuleSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capsuleBytes": {
          "type": "integer",
          "minimum": 260,
          "maximum": 4096,
          "multipleOf": 4
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptSchema",
        "operation",
        "provenanceStatus",
        "requestSHA256",
        "buildID",
        "sourceRevision",
        "sourceFilename",
        "sourceSHA256",
        "translationUnitSHA256",
        "residentBindingID",
        "board",
        "profile",
        "provenance",
        "buildInputSHA256",
        "linkedELFSHA256",
        "capsuleSHA256",
        "capsuleBytes"
      ],
      "properties": {
        "receiptSchema": {
          "const": "firmingo-compiler-declared-packaging-v1"
        },
        "operation": {
          "const": "independent_elf_packaging"
        },
        "provenanceStatus": {
          "const": "declared"
        },
        "requestSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "buildID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceFilename": {
          "type": "string"
        },
        "sourceSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "translationUnitSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "board": {
          "const": "nano_rp2040_connect"
        },
        "profile": {
          "enum": [
            "nano-managed-v1",
            "nano-managed-v2"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compiler",
            "recipeIdentifier",
            "recipeSHA256",
            "toolchainSHA256"
          ],
          "properties": {
            "compiler": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-maximumUtf8Bytes": 256
            },
            "recipeIdentifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "recipeSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "toolchainSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "buildInputSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "linkedELFSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capsuleSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capsuleBytes": {
          "type": "integer",
          "minimum": 260,
          "maximum": 4096,
          "multipleOf": 4
        },
        "residentBindingID": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}
